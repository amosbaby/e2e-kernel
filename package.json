{
  "name": "e2e-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "e2k": "bin/e2k.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/kernel/**/*.test.ts\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/playwright-driver.test.ts\"",
    "test:e2e": "npm run build && node --test \"test/browser/e2e.test.ts\"",
    "check": "npm run typecheck && npm test && npm run check:public",
    "prepare": "npm run build",
    "check:public": "node scripts/publicity-check.ts",
    "m0": "node scripts/m0/route-coverage.ts"
  },
  "dependencies": {
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
